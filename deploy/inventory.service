[Unit]
Description=Stocked API and web UI
After=network.target

[Service]
Type=simple
User=REPLACE_USER
# /srv/stocked/current is a symlink to the build in use (see scripts/update-release.sh).
WorkingDirectory=/srv/stocked/current/server
EnvironmentFile=/srv/stocked/.env
Environment=NODE_ENV=production
Environment=DATA_DIR=/srv/stocked/data
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
